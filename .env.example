# ==========================================
# ENGLISP SERVER CONFIGURATION ENVIRONMENT
# ==========================================

# 1. API SERVER & CORS SETTINGS
# ------------------------------------------
# Set this to your frontend URL (e.g., https://englisp.vercel.app). 
# Comma-separate multiple domains, or use "*" to allow all origins.
ALLOWED_ORIGINS=*

# 2. PERSISTENT STORAGE
# ------------------------------------------
# Path to user database. For hosted Docker, map this to your mounted volume.
DATABASE_PATH=web/users.db

# 3. STRIPE PAYMENTS (TEST MODE)
# ------------------------------------------
# Obtained from Stripe Dashboard (Developers -> API Keys)
STRIPE_SECRET_KEY=sk_test_51...
# Obtained from Stripe Dashboard (Developers -> Webhooks -> Add endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Obtained from Stripe Dashboard (Products -> Select product -> Price ID)
STRIPE_PRICE_ID=price_...

# 4. EMAIL DISPATCH (SMTP) CONFIGURATION
# ------------------------------------------
# Leave empty to print emails to stdout terminal and web/logs/emails/ in Dev Mode.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_api_key_here
